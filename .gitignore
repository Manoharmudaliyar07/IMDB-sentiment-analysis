# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Environments
env/
venv/
.env

# Jupyter Notebooks (not needed for deployment/showcase)
*.ipynb

# Project reports & Word documents
*.docx
*.doc
~$*
*.tmp

# Large raw datasets (only sample_reviews.csv is tracked for demo)
data/aclImdb/
data/*.tar.gz
data/*.xlsx
data/*.csv
!data/sample_reviews.csv

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
